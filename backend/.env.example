# FastAPI Settings
PROJECT_NAME="Previous Year Question (PYQ) Hub"
API_V1_STR="/api"

# Database Configuration (PostgreSQL with asyncpg)
# Format: postgresql+asyncpg://user:password@host:port/database_name
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/pyq_hub"

# JWT Auth Settings
# Generate a secure key using: openssl rand -hex 32
JWT_SECRET="7a83d4c6b8c9e0d1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2c3d4e5"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# File Storage Configuration ("local" or "s3")
STORAGE_TYPE="local"
UPLOAD_DIR="uploads"

# AWS S3 Settings (Required only if STORAGE_TYPE="s3")
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_BUCKET_NAME=""
AWS_REGION="us-east-1"
